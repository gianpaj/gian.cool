---
import { getCollection } from "astro:content";
import BlogIndex from "../components/BlogIndex.astro";
import { BLOG_PAGE_SIZE, getPublishedPosts } from "../utils/blog-posts";

const posts = getPublishedPosts(await getCollection("blog"));
const lastPage = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
---

<BlogIndex
  posts={posts.slice(0, BLOG_PAGE_SIZE)}
  currentPage={1}
  lastPage={lastPage}
  olderUrl={lastPage > 1 ? "/page/2" : undefined}
/>
