---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { postPath } from "../utils/post-path";
import ExcerptOnly from "./ExcerptOnly.astro";
import TagBadge from "./TagBadge.astro";

interface Props {
  currentPage: number;
  lastPage: number;
  newerUrl?: string;
  olderUrl?: string;
  posts: CollectionEntry<"blog">[];
}

const { posts, currentPage, lastPage, newerUrl, olderUrl } = Astro.props;
const title = currentPage === 1
  ? "Gianfranco's Blog - gian.cool"
  : `Page ${currentPage} — Gianfranco's Blog - gian.cool`;
const postsWithContent = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  }),
);
---

<Layout title={title}>
  <header class="mb-16 md:mb-20">
    <h1 class="font-serif text-5xl md:text-5xl tracking-tight leading-[1.1]">
      Gian.cool
      <span class="block text-muted dark:text-dark-muted text-3xl md:text-3xl italic mt-1">Gianfranco's blog</span>
    </h1>
  </header>

  <section>
    <ul class="space-y-12">
      {
        postsWithContent.map(({ post, Content }) => (
          <li class="group">
            <a href={postPath(post.data.pubDate, post.data.slug)} class="block">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-xs font-mono uppercase tracking-widest text-muted dark:text-dark-muted"
              >
                {post.data.pubDate.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <h2
                class="font-serif text-2xl md:text-3xl mt-1.5 group-hover:text-terracotta transition-colors duration-200"
                set:html={post.data.title.replace(/`([^`]+)`/g, "<code>$1</code>")}
              />
            </a>
            <div class="mt-3 prose-custom prose-lg dark:prose-invert">
              <ExcerptOnly>
                <Content />
              </ExcerptOnly>
            </div>
            {post.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <TagBadge tag={tag} />
                ))}
              </div>
            )}
            <a
              href={postPath(post.data.pubDate, post.data.slug)}
              class="inline-block mt-4 text-sm text-terracotta hover:underline underline-offset-2"
            >
              Read more →
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    lastPage > 1 && (
      <nav aria-label="Blog pagination" class="mt-12 grid grid-cols-2 items-center gap-4 text-sm sm:grid-cols-3">
        {newerUrl && (
          <a href={newerUrl} rel="prev" class="col-start-1 row-start-1 justify-self-start py-2 text-terracotta hover:underline underline-offset-2">
            ← Newer posts
          </a>
        )}
        <span class="col-span-2 row-start-2 text-center text-muted dark:text-dark-muted tabular-nums sm:col-span-1 sm:col-start-2 sm:row-start-1">
          Page {currentPage} of {lastPage}
        </span>
        {olderUrl && (
          <a href={olderUrl} rel="next" class="col-start-2 row-start-1 justify-self-end py-2 text-terracotta hover:underline underline-offset-2 sm:col-start-3">
            Older posts →
          </a>
        )}
      </nav>
    )
  }
</Layout>
